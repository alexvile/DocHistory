// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMITTER // нормувальник
  VIEWER // бухгалтер
}

enum SnapshotStatus {
  BASELINE // active, current
  ARCHIVED // was active in the past
  DRAFT // pending / proposed
  REJECTED // proposed but explicitly rejected
}

enum ChangeSetStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productsCreated Product[]
  NormSnapshot    NormSnapshot[]
 
  changeSetsCreated  ChangeSet[] @relation("ChangeSetCreated")
  changeSetsToReview ChangeSet[] @relation("ChangeSetApprover")
}

model Product {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  code  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  snapshots         NormSnapshot[]
  // actually this is required field
  currentSnapshotId String?        @db.ObjectId
  changeSets        ChangeSet[]
}

model NormSnapshot {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime       @default(now())
  status    SnapshotStatus

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  rows Json
  // parsedHash     String
}

model ChangeSet {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime        @default(now())
  decidedAt DateTime?

  status    ChangeSetStatus @default(DRAFT)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation("ChangeSetCreated", fields: [createdById], references: [id])

  approverId String? @db.ObjectId
  approver   User?   @relation("ChangeSetApprover", fields: [approverId], references: [id])

  oldSnapshotId String @db.ObjectId
  newSnapshotId String @db.ObjectId
  
  diff          Json
}


