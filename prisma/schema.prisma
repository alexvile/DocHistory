// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMITTER // нормувальник
  VIEWER // бухгалтер
}

enum SnapshotStatus {
  DRAFT
  BASELINE
  ARCHIVED
}

enum ChangeSetStatus {
  DRAFT
  PUBLISHED
  VIEWED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role
  email     String   @unique
  password  String
  firstName String
  lastName  String

  products   Product[]      @relation("UserProducts")
  changeSets ChangeSet[]    @relation("UserChangeSets")
  snapshots  NormSnapshot[] @relation("UserSnapshots")
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productTitle String   @unique
  code         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator   User   @relation("UserProducts", fields: [creatorId], references: [id])
  creatorId String @db.ObjectId

  snapshots NormSnapshot[] @relation("ProductSnapshots")
}

model NormSnapshot {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime       @default(now())
  label          String?
  sourceFilePath String?
  parsedHash     String
  status         SnapshotStatus @default(DRAFT)

  productId String  @db.ObjectId
  product   Product @relation("ProductSnapshots", fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation("UserSnapshots", fields: [createdById], references: [id])

  // весь нормалізований Excel одним масивом
  rows Json

  // зворотні сторони двох різних реляцій із ChangeSet
  prevForChangeSets ChangeSet[] @relation("ChangeSetPrev")
  nextForChangeSets ChangeSet[] @relation("ChangeSetNext")

  @@index([productId])
}

model ChangeSet {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime        @default(now())
  status    ChangeSetStatus @default(DRAFT)

  // хто ініціював
  creatorId String @db.ObjectId
  creator   User   @relation("UserChangeSets", fields: [creatorId], references: [id])

  // щоб легко фільтрувати історію по продукту — просто scalar (без @relation)
  productId String @db.ObjectId

  // що порівнювали
  prevSnapshotId String       @db.ObjectId
  prevSnapshot   NormSnapshot @relation("ChangeSetPrev", fields: [prevSnapshotId], references: [id])

  nextSnapshotId String       @db.ObjectId
  nextSnapshot   NormSnapshot @relation("ChangeSetNext", fields: [nextSnapshotId], references: [id])

  // результат
  diff Json
}
