generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMITTER // нормувальник
  VIEWER // бухгалтер
}

enum SnapshotStatus {
  BASELINE
  ARCHIVED
  DRAFT
}

enum ChangeSetStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productsCreated Product[]
  NormSnapshot    NormSnapshot[]
}

model Product {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  title String
  code  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  snapshots         NormSnapshot[]
  currentSnapshotId String         @db.ObjectId
}

model NormSnapshot {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime       @default(now())
  status    SnapshotStatus

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  rows Json
  // parsedHash     String
}

