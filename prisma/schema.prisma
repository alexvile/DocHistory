// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMMITTER // нормувальник
  VIEWER // бухгалтер
}

enum SnapshotStatus {
  BASELINE
  ARCHIVED
  DRAFT
}

enum ChangeSetStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productsCreated Product[]
  changeSets      ChangeSet[]
}


model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  note        String?
  code        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  currentSnapshotId String       @db.ObjectId
  currentSnapshot   NormSnapshot @relation(fields: [currentSnapshotId], references: [id])

  snapshots  NormSnapshot[]
  changeSets ChangeSet[]

  @@index([currentSnapshotId])
}
model NormSnapshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  label     String?
  status    SnapshotStatus

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  sourceFilePath String?
  parsedHash     String

  // весь Excel → нормалізований JSON
  rows Json

  // звʼязок з ChangeSet
  asPrev ChangeSet[] @relation("PrevSnapshot")
  asNext ChangeSet[] @relation("NextSnapshot")

  @@index([productId, status])
}

model ChangeSet {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime        @default(now())
  status    ChangeSetStatus @default(DRAFT)

  productId String @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation(fields: [createdById], references: [id])

  // що було
  prevSnapshotId String       @db.ObjectId
  prevSnapshot   NormSnapshot @relation("PrevSnapshot", fields: [prevSnapshotId], references: [id])

  // що хочемо зробити
  nextSnapshotId String       @db.ObjectId
  nextSnapshot   NormSnapshot @relation("NextSnapshot", fields: [nextSnapshotId], references: [id])

  // результат порівняння
  diff Json
}

